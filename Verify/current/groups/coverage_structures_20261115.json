      "driver": "Verify/current/drivers/coverage_structure_binary_ordered_main.cpp",
      "title": "Ordered Set (BinaryTrie)",
      "problem_url": "https://judge.yosupo.jp/problem/ordered_set",
      "selection_reason": "既存set_xor_minは順位を使わない。Ordered Setの答えを順位とcount_lessから直接求める。",
      "coverage": [
        "insert_unique/del",
        "重複なしget_kth/count_less",
        "順位・個数・前後要素"
      ],
      "limitations": "新規・未提出。旧ACは引き継がない。多重集合・全体XOR・ID付き要素は別entry/ローカル補足。キー0..1e9、最高bit29。",
      "samples": [
        {
          "input": "3 17\n10 20 30\n2 1\n2 2\n2 3\n3 19\n3 20\n3 21\n4 19\n4 20\n4 21\n0 0\n2 1\n0 0\n2 1\n1 0\n2 1\n1 0\n2 1\n",
          "output": "10\n20\n30\n1\n2\n2\n10\n20\n20\n0\n0\n10\n10\n",
          "source": "https://judge.yosupo.jp/problem/ordered_set",
          "origin": "Library Checker公式公開exampleの入出力。"
        },
        {
          "input": "0 4\n\n2 1\n3 1\n4 1\n5 1\n",
          "output": "-1\n0\n-1\n-1\n",
          "source": "https://judge.yosupo.jp/problem/ordered_set",
          "origin": "Library Checker公式公開exampleの入出力。"
        }
      ],
      "acl_required": false,
      "gcc_optimization": "O3,unroll-loops",
      "submission_urls": [
        "https://judge.yosupo.jp/submission/417359"
      ]
    },
