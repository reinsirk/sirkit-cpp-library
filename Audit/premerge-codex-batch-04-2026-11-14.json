    {
      "id": "geometry_point_segment_distance_full",
      "source_sha256": "9cb735ab015acf1abc2c13176e6556ac8e441b3c5d0190156c200619cb434478",
      "input_source_sha256": "9cb735ab015acf1abc2c13176e6556ac8e441b3c5d0190156c200619cb434478",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "整数点・線分をdistanceへ渡し固定12桁出力。正規化前の端点判定案は旧Clang interior13%回帰。汎用浮動精度と端点連続性を崩さない現経路を維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-09-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "整数経路では射影の符号は正規化前のd=b-aとの内積で判定できるため、端点ケースで長さのsqrtと除算2回を省ける。内部ケースはabs(cross(offset,d))/lengthで除算が1回減る。端点距離は同じconstexpr条件下で二乗和がオーバーフローしないので、hypotを直接sqrtに置換できる。既存測定でendpoint 8.88msに対しinterior 5.50msなので端点経路に余地があるとみるが未測定。結果は最終ビットが変わり得て、垂線の足が端点にごく近い入力では分岐が入れ替わり得る（距離は連続なので誤差範囲内）。浮動小数点経路は現行のスケール付きnormalizedのまま。",
            "decision_reason": "端点で大きく速くなるがClang interiorでは21回交互で約13%回帰。16構成598272 checks、full/split main8構成600照合は全通過しても全域非回帰条件を満たさない。"
          }
        ]
      },
