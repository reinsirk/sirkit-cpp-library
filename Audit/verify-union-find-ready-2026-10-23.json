  "reproduction_runner": "import pathlib,subprocess,json,hashlib\nroot=pathlib.Path('/home/reinsirk/Atcoder_Env');out=pathlib.Path(__file__).parent\nfixture=pathlib.Path('/tmp/sirkit_uf_20261022')\nh=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()\nfrozen=json.loads((out/'frozen.json').read_text())\nassert all(h(root/p)==sha for p,sha in frozen.items())\na=json.loads((root/'Audit/verify-union-find-second-pass-2026-10-22.json').read_text())\nassert all(h(root/p)==sha for p,sha in {**a['files_sha256'],**a['frozen_main_io_sha256']}.items())\nsource=(root/'Verify/current/submissions/union_find.cpp').read_text()\nassert source.count('#define SKIP_RUNTIME_CHECKS\\n')==1\nassert source.count((root/'DataStructure/union_find.cpp').read_text())==1\nreferences=json.loads((fixture/'official_reference.json').read_text())\nassert len(references)==23\nrecords=[];builds=[]\nfor cc,args in [('gcc',['g++']),('clang',['clang++','--gcc-install-dir=/opt/atcoder/gcc/lib/gcc/x86_64-pc-linux-gnu/15.3.0'])]:\n for skip in [False,True]:\n  name=cc+('_skip' if skip else '_checked');tu=out/(name+'.cpp');exe=out/name\n  tu.write_text(source if skip else source.replace('#define SKIP_RUNTIME_CHECKS\\n','',1))\n  cmd=[*args,'-std=c++23','-O2','-Wall','-Wextra','-Werror','-pedantic-errors',str(tu),'-o',str(exe)]\n  b=subprocess.run(cmd,capture_output=True,text=True);assert b.returncode==0,b.stderr\n  builds.append(dict(configuration=name,command=cmd,compile_returncode=b.returncode,diagnostics=b.stderr,source_sha256=h(tu)))\n  for ref in references:\n   case=fixture/ref['scope']/ref['case'];expected=fixture/'reference_outputs'/(ref['case']+'.out')\n   assert h(case)==ref['input_sha256'] and h(expected)==ref['output_sha256']\n   with case.open('rb') as inp:r=subprocess.run([str(exe)],stdin=inp,capture_output=True)\n   assert r.returncode==0 and not r.stderr and r.stdout==expected.read_bytes(),(name,ref['case'],r.stderr)\n   records.append(dict(configuration=name,case=ref['case'],scope=ref['scope'],input_sha256=h(case),expected_sha256=h(expected),output_sha256=hashlib.sha256(r.stdout).hexdigest(),returncode=r.returncode))\n  print(name,len(references),'cases PASS',flush=True)\nassert all(h(root/p)==sha for p,sha in frozen.items())\n(out/'results.json').write_text(json.dumps(dict(status='PASS',frozen_sha256=frozen,prior_audit_all_artifacts_match=True,builds=builds,records=records),indent=2)+'\\n')\n"
