    "run.py": "from pathlib import Path\nimport subprocess,json,hashlib\np=Path(__file__).parent;r=Path('/home/reinsirk/Atcoder_Env');sha=lambda b:hashlib.sha256(b).hexdigest();baseline=p.parent/'baseline/DataStructure/dynamic-union-find.cpp';current=r/'DataStructure/dynamic-union-find.cpp';records=[]\nfor cc,args in [('gcc',['g++']),('clang',['clang++','--gcc-install-dir=/opt/atcoder/gcc/lib/gcc/x86_64-pc-linux-gnu/15.3.0'])]:\n for label,header in [('baseline',baseline),('current',current)]:\n  exe=p/(cc+'_'+label);cmd=['taskset','-c','6',*args,'-std=c++23','-O2','-DSKIP_RUNTIME_CHECKS=','-DDUF_HEADER=\"'+str(header)+'\"',str(p/'probe.cpp'),'-o',str(exe)];a=subprocess.run(cmd,capture_output=True,text=True,check=True);b=subprocess.run([str(exe)],capture_output=True,text=True,check=True);rows=[]\n  for line in b.stdout.splitlines():\n   n,mode,peak,retained,calls,delta=map(int,line.split(','));rows.append(dict(n=n,state=['singleton','connected','pairs'][mode],peak_extra_requested_bytes=peak,result_requested_bytes=retained,allocation_calls=calls,live_bytes_delta_after_result_destroyed=delta))\n  records.append(dict(compiler=cc,variant=label,command=cmd,source_sha256=sha(header.read_bytes()),stderr=a.stderr+b.stderr,rows=rows));print(cc,label,'PASS',len(rows),flush=True)\nsummary=[]\nfor cc in ['gcc','clang']:\n old=next(x for x in records if x['compiler']==cc and x['variant']=='baseline')['rows'];new=next(x for x in records if x['compiler']==cc and x['variant']=='current')['rows']\n for x,y in zip(old,new):\n  assert x['n']==y['n']and x['state']==y['state'];assert x['result_requested_bytes']==y['result_requested_bytes'];assert x['live_bytes_delta_after_result_destroyed']==y['live_bytes_delta_after_result_destroyed']==0\n  summary.append(dict(compiler=cc,n=x['n'],state=x['state'],baseline_peak=x['peak_extra_requested_bytes'],current_peak=y['peak_extra_requested_bytes'],bytes_saved=x['peak_extra_requested_bytes']-y['peak_extra_requested_bytes'],baseline_allocations=x['