  "reproduction_runner": "import pathlib,json,hashlib,subprocess\nroot=pathlib.Path('/home/reinsirk/Atcoder_Env');out=pathlib.Path(__file__).parent\nsha=lambda p:hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()\nfrozen=json.loads((out/'frozen.json').read_text());assert all(sha(root/p)==s for p,s in frozen.items())\nfixtures=json.loads(pathlib.Path('/tmp/sirkit_four_hours_20261022/algorithms/trie/cases.json').read_text());assert len(fixtures)==19\nfor f in fixtures:\n assert sha(f['input'])==f['input_sha256'] and sha(f['answer'])==f['answer_sha256']\n words=pathlib.Path(f['input']).read_text().split();n=int(words[0]);assert len(words)==n+1 and 1<=n<=200000\n assert all(1<=len(w)<=10 and all('a'<=c<='z' for c in w) for w in words[1:])\n assert int(pathlib.Path(f['answer']).read_text())==len(set(words[1:]))\nsource=(root/'Verify/current/submissions/trie_dictionary.cpp').read_text();assert source.count('#define SKIP_RUNTIME_CHECKS\\n')==1\nassert (root/'String/Trie.cpp').read_text() in source\nrows=[];builds=[]\nfor tag,args in [('gcc',['g++']),('clang',['clang++','--gcc-install-dir=/opt/atcoder/gcc/lib/gcc/x86_64-pc-linux-gnu/15.3.0'])]:\n for skip in [False,True]:\n  name=tag+('_skip'if skip else'_checked');tu=out/(name+'.cpp');exe=out/name\n  tu.write_text(source if skip else source.replace('#define SKIP_RUNTIME_CHECKS\\n','',1))\n  cmd=[*args,'-std=c++23','-O2','-Wall','-Wextra','-Werror','-pedantic-errors',str(tu),'-o',str(exe)]\n  r=subprocess.run(cmd,capture_output=True,text=True);assert r.returncode==0,r.stderr\n  builds.append(dict(configuration=name,command=cmd,returncode=r.returncode,diagnostics=r.stderr,source_sha256=sha(tu)))\n  for f in fixtures:\n   with pathlib.Path(f['input']).open('rb')as inp:r=subprocess.run([str(exe)],stdin=inp,capture_output=True)\n   expected=pathlib.Path(f['answer']).read_bytes();assert r.returncode==0 and not r.stderr and r.stdout==expected,(name,f['name'],r.stderr)\n   rows.append(dict(configuration=name,case=f['name'],kind=f['kind'],returncode=r.returncode,input_sha256=f['input_sha256'],expected_sha256=f['answer_sha256'],output_sha256=hashlib.sha256(r.stdout).hexdigest()))\n  print(name,len(fixtures),'cases PASS',flush=True)\nassert all(sha(root/p)==s for p,s in frozen.items())\n(out/'current_validation.json').write_text(json.dumps(dict(status='PASS',frozen=frozen,fixture_count=19,all_fixtures_rechecked_with_python_set=True,builds=builds,rows=rows),indent=2)+'\\n')\n"
