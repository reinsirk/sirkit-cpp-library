    {
      "id": "implicit_treap_deque",
      "source_sha256": "53f419660d28f6bf0767ec71cffb1da47691fdb4202305a9e385f33ff7049d71",
      "input_source_sha256": "53f419660d28f6bf0767ec71cffb1da47691fdb4202305a9e385f33ff7049d71",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "uint32係数・uint64積でmod順序を保ち、q reserveを適用済み。非可換前後集約/逆転と容量再利用を維持し、APIを別deque構造へ置換しない。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-04-2026-11-13.json",
            "decision": "adopt",
            "candidate_reason": "Sがint64×2のためvalue/forward/backwardで48バイト、非compactのNodeは約80バイトで2キャッシュ線にまたがる。Sをuint32×2にすると約56バイトになり、%も符号なしになる(効果は未測定)。driverのみの変更。",
            "decision_reason": "積前uint64化でSをuint32x2へ縮小し、実StoredNode80→56B/align8。全Nodeが1cachelineに収まるとは主張しない。独立16＋実main32構成、3同seed・50万queryでGCC約1〜2%、Clang約6〜10%短縮、低占有は誤差内。製品時計seedは変更せず、計時用seedだけ揃えた。O3維持。"
          }
        ]
      },
