    {
      "id": "implicit_treap_affine",
      "source_sha256": "18052b31790730881c23756998a15f5588842d4739e9de61124c3010639f9681",
      "input_source_sha256": "18052b31790730881c23756998a15f5588842d4739e9de61124c3010639f9681",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "vector初期列は線形Cartesian構築。S/Fと64B compact経路を維持。n+q reserveは旧利益混在、op条件減算も旧GCC約8%回帰のため再提案しない。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-04-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "pullごとに2回呼ばれるopの加算に64bit符号付き%がある。両辺<modなので条件減算で足り、S/Fのサイズは変えないのでcompact経路(sizeof==64)は維持される。効果は小さい可能性があり未測定。",
            "decision_reason": "S/FとCompactNode64B経路を保った独立検証はPASSだが、GCC random/退化で約8%回帰しClang利益と両立しない。既存の%を維持。"
          }
        ]
      },
