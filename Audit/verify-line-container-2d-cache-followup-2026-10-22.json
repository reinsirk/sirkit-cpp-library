    "source": "// SPDX-License-Identifier: CC0-1.0\n#include \"baseline_count_access.hpp\"\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cinttypes>\n#include <cstdio>\n#include <limits>\n#include <stdexcept>\nstatic std::uint64_t checks=0;\ntemplate<class Table>static void inspect_count_limit(){\n for(bool seeded:{false,true}){\n  Table h;if(seeded)h.add(7,-9);\n  h.count_=std::numeric_limits<std::size_t>::max()-1;\n  h.add(-13,17);assert(h.size()==std::numeric_limits<std::size_t>::max());\n  const auto min_nodes=h.minlc.size(),max_nodes=h.maxlc.size();\n  const auto min_value=h.min_ld(3,2),max_value=h.max_ld(3,2);\n  const auto xmin=h.Xmin,xmax=h.Xmax,ymin=h.Ymin,ymax=h.Ymax;\n  bool failed=false;try{h.add(100,200);}catch(const std::length_error&){failed=true;}\n  assert(failed&&h.size()==std::numeric_limits<std::size_t>::max());\n  assert(h.minlc.size()==min_nodes&&h.maxlc.size()==max_nodes);\n  assert(h.min_ld(3,2)==min_value&&h.max_ld(3,2)==max_value);\n  assert(h.Xmin==xmin&&h.Xmax==xmax&&h.Ymin==ymin&&h.Ymax==ymax);\n  h.clear();assert(h.empty()&&h.size()==0&&h.minlc.empty()&&h.maxlc.empty());\n  h.add(3,-5);assert(h.size()==1&&h.min_ld(2,3)==-9&&h.max_ld(2,3)==-9);\n  assert(h.Xmin==3&&h.Xmax==3&&h.Ymin==-5&&h.Ymax==-5);\n  checks+=9;\n }\n}\nint main(){inspect_count_limit<LineContainer2D>();std::printf(\"lc2d count limit checks: %\" PRIu64 \"\\n\",checks);}\n"
  },
