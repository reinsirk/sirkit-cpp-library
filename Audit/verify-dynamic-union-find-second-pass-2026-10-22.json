      "source": "from pathlib import Path\nimport subprocess as sp,json,hashlib\np=Path(__file__).parent;r=Path('/home/reinsirk/Atcoder_Env');base=(p/'baseline.hpp').read_text();final=(p/'final.hpp').read_text();assert final==(r/'DataStructure/dynamic-union-find.cpp').read_text();frozen=(p/'dynamic_union_find.cpp').read_text();assert frozen.count(base)==1;out={'main':[],'examples':[],'guards':[],'preprocessor':[],'text_proof':[],'source_proof':{}};sha=lambda b:hashlib.sha256(b).hexdigest()\n# 追加したprivate helperとgroupsの分岐を取り除くとファイル全体がbaselineと一致。\nstart=final.index('    std::vector<std::vector<int>> trivial_groups() {');begin=final.index('{',start);i=begin+1;depth=1\nwhile depth:\n if final[i]=='{':depth+=1\n elif final[i]=='}':depth-=1\n i+=1\nreverted=(final[:start]+final[i+2:]).replace('        if (components_ == nodes_.size() || components_ == 1) return trivial_groups();\\n','');assert reverted==base\nmarker='#ifndef SIRKIT_INTERNAL_HASH_MAP_DEFINED';endmarker='#endif  // SIRKIT_INTERNAL_HASH_MAP_DEFINED'\ndef block(s):a=s.index(marker);b=s.index(endmarker,a)+len(endmarker);return s[a:b]\nassert block(base)==block(final);shared=block((r/'Internal/Nyaan_hash_map_min.cpp').read_text());assert shared==block(final)\nout['source_proof']={'only_groups_dispatch_and_private_helper_changed':True,'shared_hash_byte_identical':True,'shared_hash_guarded_block_sha256':sha(shared.encode()),'baseline_sha256':sha(base.encode()),'final_sha256':sha(final.encode()),'driver_sha256':sha((p/'dynamic_union_find_main.cpp').read_bytes()),'io_sha256':sha((p/'fast_io.hpp').read_bytes())}\nccs={'gcc':['g++'],'clang':['clang++','--gcc-install-dir=/opt/atcoder/gcc/lib/gcc/x86_64-pc-linux-gnu/15.3.0']};old=Path('/tmp/sirkit_duf_20261022/official');hashes=json.loads((old/'hash.json').read_text());cases=[]\nfor q in sorted((old/'in').glob('*.in')):\n data=q.read_bytes();expected=(old/'out'/(q.stem+'.out')).read_bytes();assert sha(data)==hashes[q.name]and sha(expected)==hashes[q.stem+'.out'];cases.append((q.name,data,expected))\nfor cc,args in ccs.items():\n texts={}\n for v,skip in[('baseline',True),('control',True),('final',True),('final',False)]:\n  tag=v+('_skip'if skip else'_checked');tu=p/(cc+'_'+tag+'.cpp');s=frozen.replace(base,(p/(v+'.hpp')).read_text());s=s if skip else s.removeprefix('#define SKIP_RUNTIME_CHECKS\\n');tu.write_text(s);exe=tu.with_suffix('');cmd=['taskset','-c','10',*args,'-std=c++23','-O2','-Wall','-Wextra','-Werror','-pedantic-errors',str(tu),'-o',str(exe)];q=sp.run(cmd,capture_output=True,text=True);assert not q.returncode,q.stderr\n  if skip:\n   text=Path(str(exe)+'.text');sp.run(['objcopy','--dump-section','.text='+str(text),str(exe)],check=True);texts[v]=sha(text.read_bytes())\n  if v=='final':\n   for name,data,expected in cases:\n    q=sp.run(['taskset','-c','10',str(exe)],input=data,capture_output=True);assert not q.returncode and not q.stderr and q.stdout==expected,(cc,tag,name,q.stderr);out['main'].append({'configuration':cc+'_'+tag,'case':name,'input_sha256':sha(data),'output_sha256':sha(q.stdout),'passed':True})\n assert len(set(texts.values()))==1,(cc,texts);out['text_proof'].append({'compiler':cc,'baseline_control_final_text_identical':True,'sha256':texts['final']})\n for skip in[False,True]:\n  name=cc+('_skip'if skip else'_checked');flags=['-DSKIP_RUNTIME_CHECKS']if skip else[];example=r/'Examples/dynamic_union_find_example.cpp';exe=p/('example_'+name);cmd=['taskset','-c','10',*args,'-std=c++23','-O2','-Wall','-Wextra','-Werror','-pedantic-errors',*flags,str(example),'-o',str(exe)];q=sp.run(cmd,capture_output=True,text=True);assert not q.returncode,q.stderr;q=sp.run(['taskset','-c','10',str(exe)],capture_output=True,text=True);assert not q.returncode and not q.stderr and q.stdout=='3 4\\n1 2\\n0 4\\n2 2\\n5 3\\n1\\n';out['examples'].append({'configuration':name,'stdout':q.stdout,'passed':True})\n  tu=p/('guard_'+name+'.cpp');tu.write_text('#include \"'+str(r/'Internal/Nyaan_hash_map_min.cpp')+'\"\\n#include \"final