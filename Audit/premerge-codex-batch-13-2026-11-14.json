    {
      "id": "geometry_convex_hull_split",
      "source_sha256": "7cd56e9c41022baa448b794e6f0c3a3e5aa9514f3b0832b768803aac1f53c998",
      "input_source_sha256": "7cd56e9c41022baa448b794e6f0c3a3e5aa9514f3b0832b768803aac1f53c998",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "PointI列をmoveしてconvex_hullへ渡し初期copyを避ける。radix度数融合は旧wide-span/few-byteで14〜21%回帰、unique/復元融合もduplicate4.5〜7.1%回帰のため維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-08-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "全桁集計の要否はキー生成前にspan_x/span_yから決められるので、度数集計をキー生成ループに融合すればkeysの独立した1走査が消える。度数はvaryingに依らず正しく、varying==0の桁は従来どおり飛ばすため結果は不変。varyingの実桁数がspan上界より少ない入力では余分な集計になり得る。",
            "decision_reason": "乱数で安定改善せず、wide-span/few-varying-byte重複で本体14〜21%回帰。両コンパイラ/full splitで確認。"
          },
          {
            "record": "Audit/optimization-fable-batch-08-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "現在はkeysのstd::unique（1走査）のあと座標復元（1走査）を行っており、重複除去と復元を1ループにまとめればkeysの走査が1回減る。points.size()==keys.size()かつm<=iなので書込みは範囲内で、resizeは縮小のみ。",
            "decision_reason": "直線で約4%改善するが、重複で本体4.5〜7.1%回帰。全64正当性構成PASSでも一律採用条件を満たさない。"
          }
        ]
      },
