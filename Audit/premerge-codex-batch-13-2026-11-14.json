    {
      "id": "geometry_triangle_area_split",
      "source_sha256": "f5f9b4b354cdce4f3ba10cbc8f9d8fe4f9e26e3dd088511fc903adbb71bee78e",
      "input_source_sha256": "f5f9b4b354cdce4f3ba10cbc8f9d8fe4f9e26e3dd088511fc903adbb71bee78e",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "整数3点のareaを呼び固定12桁出力。大多角形shoelace候補の利益を3点mainへ転用しない（旧Clang3点core2.6〜2.7%回帰）。原点差分と正確な整数計算を維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-09-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "Tが64bit以下でCが__int128_tなら、C(x_i)*C(y_j)は符号拡張64×64→128となりオーバーフローしない。累積を__uint128_tで行えば和は2^128を法として真値に一致するので、真の結果がCに収まる全入力（現行契約を包含）で現行と同じ整数を返す。原点差分の128bit減算2回と128×128乗算2回が拡幅乗算2回に減る見込みだが未測定。浮動小数点と他のCは精度維持のため現行経路のまま。",
            "decision_reason": "大きい多角形では約51〜54%短縮するが、Verifyが使う固定3点ではClang coreが約2.6〜2.7%回帰、反復範囲も分離。24構成独立多倍長/UBSan/fallback等は通過。大列の利益を小mainの性能へ転用しない。"
          }
        ]
      },
