    {
      "id": "zeta_and_split",
      "source_sha256": "40e134f1eb00bfc47bf7b3b66da0610fa56f66cd982da9178fda47251a1aa8a1",
      "input_source_sha256": "40e134f1eb00bfc47bf7b3b66da0610fa56f66cd982da9178fda47251a1aa8a1",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "VerifyMod998のuint32値を直接読み、2入力をmove渡しする。Superset2段融合は旧GCCで約4〜10%回帰のため再提案せず、必要なmod条件減算を維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-07-2026-11-13.json",
            "decision": "adopt",
            "candidate_reason": "main が lvalue を値渡ししており、以後使わない a, b を n 要素ずつ2本、確保してコピーしている。API は rvalue の領域移譲を明記している。OR-as-AND は次の候補に含めた。効果は未測定で、小さい見込み。",
            "decision_reason": "使用済み入力vectorをmoveしてコピー2本を除去。128構成独立照合と生成版32構成PASS。最大random/zero全条件で全体短縮、RSS約8MiB減。小nの起動支配の数us差は別記。"
          },
          {
            "record": "Audit/optimization-fable-batch-07-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "superset でも a+=b, c+=d, a+=c, b+=d の順にすれば各要素への演算列が1段ずつの場合と同じになり、2^20 でメモリ走査がおよそ半分になる。Subset 限定が過去の回帰計測に基づくなら、この案は取り下げる。未測定。Zeta_Mebius.cpp 側は該当箇所が同じ形であることを確認してから適用する。",
