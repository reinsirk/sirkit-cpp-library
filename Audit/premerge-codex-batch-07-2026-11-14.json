    {
      "id": "heap_priority_queue",
      "source_sha256": "46afd7cb55910e73a178c77138f5b78efb081c686fe21cd2365232ecdfc6acf7",
      "input_source_sha256": "46afd7cb55910e73a178c77138f5b78efb081c686fe21cd2365232ecdfc6acf7",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "公開Heapの四分/二分hole修復を維持。push_pop/初期k別loopは旧k=NやClang昇順で回帰し、pop_valueの検証を失うため再提案しない。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-03-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "サイズk到達後のpush→pop_valueは既存APIのpush_pop(value)と等価(k>=1)。push_popはvalue<=最小値なら比較1回でヒープに触れず、それ以外もrepair_root 1回で済む。ランダム順列では大半が比較1回で終わる見込みだが未測定。AtCoderは本体中心なのでdriver変更の優先度は低く、pop_valueの検証カバレッジが外れる点も要判断。",
            "decision_reason": "push_pop融合はrandom/降順で速いが、heap.size条件/i<k条件/最初k個を別loopで初期化の3案ともk=N降順やClang昇順で回帰が残った。64573小入力/全k/重複/整数境界は正常。現mainとpop_value online coverageを維持する。"
          }
        ]
      },
