{
  "date_jst": "2026-11-02",
  "checked_at_utc": "2026-11-02T03:46:57.767570+00:00",
  "scope": "Fenwick Tree・Segment Tree・Lazy Segment TreeをACLの公開APIへ統一。追加機能は保持し、同機能の旧公開名・別名を作らない。",
  "public_types": [
    "fenwick_tree<T>",
    "segtree<S,op,e>",
    "lazy_segtree<S,op,e,F,mapping,composition,id>"
  ],
  "namespace": "global（従来方針。atcoder::の別名は定義しない）",
  "canonical_details": [
    "intのサイズ・添字・境界探索戻り値",
    "Sを値で返すget/all_prod",
    "segtree/lazy_segtreeの関数NTTP op/e/mapping/composition/id",
    "述語をNTTPまたは引数で渡す2形式",
    "fenwick_tree::sum と lazy_segtree::all_prod の非constメンバ関数型もACLと一致",
    "Fenwickの整数剰余動作、static/dynamic modint対応"
  ],
  "removed_duplicates": [
    "旧公開型FenwickTree/SegmentTree/LazySegmentTree",
    "Fenwickのprefix_sum/all_sum（sumへ統一）",
    "Lazyのapply_all（applyへ統一）"
  ],
  "extensions": [
    "vectorからのFenwick O(n)構築。制約付きテンプレートによりACLのf({})/f({n})の解釈も保つ",
    "get/set/values/境界探索（Fenwick）",
    "transform/values/assign/reset/clear/swap/size/emptyの適用可能な操作",
    "Lazy mapping(F,S,size_t)も指定可。標準のmapping(F,S)を優先する",
    "独自の可換加法群では内部変換と復元時の余分な値コピーを避ける"
  ],
  "differences_from_acl": [
    "公開型はグローバル",
    "無効入力はassertではなく例外。SKIP_RUNTIME_CHECKSで入力検査を除く",
    "内部容量・添字・intサイズ表現の保護は維持"
  ],
