        "patch": "-struct PointAffineFunction { std::uint64_t a = 1, b = 0; };\n+struct PointAffineFunction { std::uint32_t a = 1, b = 0; };\n operator(): return {static_cast<std::uint32_t>(std::uint64_t{left.a} * right.a % 998244353),\n                     static_cast<std::uint32_t>((std::uint64_t{left.b} * right.a + right.b) % 998244353)};\n main: verify_out << (std::uint64_t{f.a} * x + f.b) % 998244353 << '\\n';",
