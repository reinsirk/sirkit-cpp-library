    {
      "id": "angle_sort_std",
      "source_sha256": "988d8cc5a9e07fe4b4bc8c81c5147345a154580d5e097655e7f9ed707ab309ff",
      "input_source_sha256": "988d8cc5a9e07fe4b4bc8c81c5147345a154580d5e097655e7f9ed707ab309ff",
      "decision": {
        "decision": "reject_candidate_keep_current",
        "current_review_reason": "AngleLess関数オブジェクトは既に適用済み。整数比較の順序は維持し、出力用std::rotateのみ2区間出力へ置換するmain案を測定中。 Same source-level idea but GCC axes duplicate and sorted large cases regress reproducibly (~1.3% and ~0.8% versus baseline); retain current driver despite Clang mixed gains.",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-10-2026-11-13.json",
            "decision": "adopt",
            "candidate_reason": "std::sortに関数名arccmp_lessを渡すと関数ポインタになり、GCCがsort内部で比較をインライン化しない場合があります。関数オブジェクトなら型で呼び先が確定します。効果は未測定で、既にインライン化されていれば差は出ません。",
            "decision_reason": "AngleLessはarccmp_lessへの直接委譲。本体/I/Oを変えず型で比較先を確定するmain変更。32独立構成と68Python大整数参照入力、最大5分布で非回帰。GCC設定も新mainでnone/O3/unrollを別測定しO3採用（全5分布で短縮、unrollは混在）。通常最終8構成/派生4構成もPASS。mainの変更とGCC設定の短縮率を加算せず、本体改善とも扱わない。coverage説明も同期。"
          }
        ]
      },
      "compiler": {
        "path": "/usr/bin/g++",
        "version": "g++ (Ubuntu 15.2.0-16ubuntu1) 15.2.0"
      },
      "flags_and_gcc_pragmas": [
        "#pragma GCC optimize(\"O3\")"
      ],
