ce_sha256=digest,command=cmd,compile_code=a.returncode,warnings=a.stderr)\n  if a.returncode==0:\n   env=os.environ.copy();env['ASAN_OPTIONS']='detect_leaks=0';a=subprocess.run(['taskset','-c','10',str(binary)],capture_output=True,text=True,env=env);row.update(run_code=a.returncode,stdout=a.stdout,stderr=a.stderr)\n  rows.append(row);print(name,test,row.get('run_code',row['compile_code']),row.get('stdout','').strip(),flush=True)\n fcntl.flock(lock,fcntl.LOCK_UN);lock.close()\n return rows\nwith concurrent.futures.ThreadPoolExecutor(1)as pool:\n rows=[row for group in pool.map(check,configs)for row in group]\n(out/'results.json').write_text(json.dumps(dict(source_sha256=digest,callback_required=args.callback,results=rows),indent=2)+'\\n')\nassert all(row.get('run_code')==0 for row in rows),[row for row in rows if row.get('run_code')!=0]\n",
    "check_official_native.py": "from pathlib import Path\nimport subprocess,json,concurrent.futures,hashlib,fcntl,argparse\nr=Path('/home/reinsirk/Atcoder_Env');p=Path(__file__).parent.parent;v=p/'verify';official=Path('/tmp/sirkit_sieve_20261022/official')\nparser=argparse.ArgumentParser();parser.add_argument('source',type=Path);parser.add_argument('--label',required=True);args=parser.parse_args();base=args.source.resolve()\ndriver=(v/'frozen_driver.cpp').read_text()\nconfigs=[(c,True,False) for c in ['gcc','clang']]\ndef check(item):\n lock=open('/tmp/atcoder_full_performance_20261018/benchmark.lock','a');fcntl.flock(lock,fcntl.LOCK_EX)\n c,skip,disabled=item;name=args.label+'_'+c+'_native'+('_skip'if skip else'_checked')+('_disabled'if disabled else'');src=v/(name+'.cpp');exe=v/name\n src.write_text(('#define SKIP_RUNTIME_CHECKS\\n'if skip else'')+('#define SIRKIT_DISABLE_SIMD\\n'if disabled else'')+'#include \"'+str(base)+'\"\\n'+driver)\n cmd=['taskset','-c','10',*(['g++']if c=='gcc'else['clang++','--gcc-install-dir=/opt/atcoder/gcc/lib/gcc/x86_64-pc-linux-gnu/15.3.0']),'-std=c++23','-O2','-march=native',str(src),'-o',str(exe)]\n a=subprocess.run(cmd,capture_output=True,text=True);assert a.returncode==0,a.stderr\n results=[]\n for f in sorted((official/'in').glob('*.in')):\n  a=subprocess.run(['taskset','-c','10',str(exe)],input=f.read_bytes(),capture_output=True);assert a.returncode==0,(name,f.name,a.stderr);out=official/'out'/(f.stem+'.out');assert a.stdout.split()==out.read_bytes().split(),(name,f.name)\n  results.append(f.stem)\n fcntl.flock(lock,fcntl.LOCK_UN);lock.close()\n print(name,len(results),'PASS',flush=True);return dict(name=name,source_sha256=hashlib.sha256(base.read_bytes()).hexdigest(),command=cmd,compile_stderr='',cases_passed=results)\n# One worker prevents functional tests from competing heavily with CPU14 performance probes.\nwith concurrent.futures.ThreadPoolExecutor(1)as pool:rows=list(pool.map(check,configs))\n(p/(args.label+'_official_