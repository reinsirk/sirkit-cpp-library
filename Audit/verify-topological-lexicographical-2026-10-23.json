  "reproduction_script": "from pathlib import Path\nimport json,hashlib,subprocess,fcntl,heapq,statistics,time,resource\nr=Path('/home/reinsirk/Atcoder_Env');p=Path(__file__).parent;sha=lambda b:hashlib.sha256(b).hexdigest();body=(r/'Graph/Topological_sort.cpp').read_bytes();src=(r/'Verify/current/submissions/topological_lexicographical.cpp').read_bytes();audit=json.loads((r/'Audit/performance-topological-submission-2026-10-23.json').read_text());assert sha(body)==audit['source_hashes']['Graph/Topological_sort.cpp'];assert body==(r/'Graph/Topological.cpp').read_bytes();assert body in src\nmeta=next(x for x in json.loads((r/'Verify/current/groups/structures.json').read_text())['entries']if x['id']=='topological_lexicographical');cases=[x for x in json.loads((r/'Audit/performance-topological-2026-10-22.json').read_text())['inputs']if x['id']=='topological_lexicographical'];assert len(cases)==10\nfor i,s in enumerate(meta['samples'],1):assert s['input']==Path(next(c['input']for c in cases if c['case']=='sample'+str(i))).read_text()\n# 遅延ビット集合を使わず、heapqで最小候補を取り出す独立参照。\nfor c in cases:\n data=Path(c['input']).read_bytes();assert sha(data)==c['input_sha256'];vals=list(map(int,data.split()));n,m=vals[:2];assert 2<=n<=200000 and 1<=m<=200000 and len(vals)==2+2*m;adj=[[]for _ in range(n)];degree=[0]*n\n for u,v in zip(vals[2::2],vals[3::2]):\n  assert 1<=u<=n and 1<=v<=n and u!=v;adj[u-1].append(v-1);degree[v-1]+=1\n q=[i for i,d in enumerate(degree)if d==0];heapq.heapify(q);order=[]\n while q:\n  u=heapq.heappop(q);order.append(u+1)\n  for v in adj[u]:\n   degree[v]-=1\n   if degree[v]==0:heapq.heappush(q,v)\n expected=(' '.join(map(str,order))+'\\n')if len(order)==n else'-1\\n';assert sha(expected.encode())==c['output_sha256'];assert Path(c['expected']).read_text()==expected\nconfigs={'gcc15_2_atcoder_related':(['/usr/bin/g++'],['-std=gnu++23','-march=native','-ftrivial-auto-var-init=zero','-DATCODER','-DNOMINMAX','-DONLINE_JUDGE']),'clang21_standard':(['/usr/bin/clang++','--gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/15'],['-std=c++23','-pedantic-errors','-DSIRKIT_DISABLE_SIMD'])}\nout={'status':'INCOMPLETE','source_sha256':sha(body),'submission_sha256':sha(src),'driver_sha256':sha((r/meta['driver']).read_bytes()),'io_sha256':sha((r/'Verify/current/common/fast_io.hpp').read_bytes()),'online_submission_performed':False,'fixtures':cases,'independent_reference':'Python heapqによる最小候補管理。全10入力を再計算し、候補ビット集合に依存しない期待値と照合。','source_api_verification':'Audit/performance-topological-submission-2026-10-23.json。source SHA一致のまま、全公開API・閉路・一意性・入力不変性・確保失敗・境界434件・ASan/UBSanは既存検証結果を参照。今回、本体変更はない。','builds':[],'outputs':[],'timing_raw_ms':{}}\nwith open('/tmp/sirkit_performance_cpu14.lock','a')as a,open('/tmp/atcoder_full_performance_20261018/benchmark.lock','a')as b:\n fcntl.flock(a,fcntl.LOCK_EX);fcntl.flock(b,fcntl.LOCK_EX)\n for config,(cc,extra)in configs.items():\n  for skip in [False,True]:\n   name=config+('_skip'if skip else'_checked');source=p/(name+'.cpp');source.write_bytes(src if skip else src.replace(b'#define SKIP_RUNTIME_CHECKS\\n',b'',1));exe=source.with_suffix('');cmd=['taskset','-c','6',*cc,'-O2','-Wall','-Wextra','-Werror',*extra,str(source),'-o',str(exe)];q=subprocess.run(cmd,capture_output=True,text=True);assert q.returncode==0 and not q.stderr,(cmd,q.stderr);out['builds'].append(cmd)\n   for c in cases:\n    with Path(c['input']).open('rb')as inp,(p/'answer.out').open('wb')as f:q=subprocess.run(['taskset','-c','14',str(exe)],stdin=inp,stdout=f,stderr=subprocess.PIPE)\n    assert q.returncode==0 and not q.stderr and sha((p/'answer.out').read_bytes())==c['output_sha256'];out['outputs'].append({'config':name,'case':c['case'],'kind':c['kind'],'sha256':c['output_sha256']})\n   print(name,'10 outputs PASS',flush=True)\n for rep in range(7):\n  for c in cases[rep:]+cases[:rep]:\n   with Path(c['input']).open('rb')as inp,(p/'answer.out').open('wb')as f:\n    before=resource.getrusage(resource.RUSAGE_CHILDREN);t=time.perf_counter_ns();q=subprocess.run(['taskset','-c','14',str(p/'gcc15_2_atcoder_related_skip')],stdin=inp,stdout=f,stderr=subprocess.PIPE);wall=(time.perf_counter_ns()-t)/1e6;after=resource.getrusage(resource.RUSAGE_CHILDREN)\n   assert q.returncode==0 and not q.stderr and sha((p/'answer.out').read_bytes())==c['output_sha256'];out['timing_raw_ms'].setdefault(c['case'],[]).append({'wall_ms':wall,'cpu_ms':1000*(after.ru_utime+after.ru_stime-before.ru_utime-before.ru_stime)})\n  print('round',rep,flush=True)\nout['median_ms']={case:{k:statistics.median(x[k]for x in ts)for k in ['cpu_ms','wall_ms']}for case,ts in out['timing_raw_ms'].items()};out['status']='READY_FOR_ONLINE_SUBMISSION';out['local_status']='PASS';out['measurement_note']='現行版の基準値のみ。高速化率やオンラインACではない。GCC15.2関連設定で固定main/共通I/O・検査省略、build CPU6/run CPU14、ロック併用、通常ファイル出力、7ラウンド。公式の全リンク条件や実機環境の再現ではない。Clangは標準C++23・march指定なし。';out['problem_url']=meta['problem_url'];out['official_sample_passes']=sum(c['kind']=='official_sample'for c in out['outputs']);out['custom_reference_passes']=sum(c['kind']!='official_sample'for c in out['outputs']);out['reproduction_script']=(p/'verify.py').read_text();(r/'Audit/verify-topological-lexicographical-2026-10-23.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\\n');print('ALL PASS',flush=True)\n"
