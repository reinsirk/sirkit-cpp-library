    {
      "id": "hash_set_membership",
      "source_sha256": "742e4504d58ff66b96c7da3ffb24ce061b029facdaad003998cde1b6b79e633e",
      "input_source_sha256": "742e4504d58ff66b96c7da3ffb24ce061b029facdaad003998cde1b6b79e633e",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "和をint64で保持しfindなしのcontains出力。n*m*l全予約は全和同値で旧GCC2.154倍/Clang1.132倍の回帰があるため維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-01-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "最大10^6回の挿入で8から倍々に再配置している。ClangはSIMD再配置と事前書き込みが無効で35msとGCCより遅く、事前reserveで再配置を消せる可能性がある。同一和の退化列では大きな表の確保が純損になり得る（圧縮trieのreserveと同種のリスク）。",
            "decision_reason": "全容量reserveはrandomで短縮するが、全和同一でGCC2.154倍/Clang1.132倍に回帰しRSS増。問題の合法な退化入力で損失が大きい。"
          },
          {
            "record": "Audit/optimization-fable-batch-01-2026-11-13.json",
            "decision": "reject",
            "candidate_reason": "HashSet::locateをHashMap::locateと同じ二段にすると、墓石のない連では1条件で進める。墓石スロットは破棄済みなので、第1ループは state==1 のみ比較する形で非自明キーでも安全。効果は小さい可能性があり優先度は低い。",
            "decision_reason": "固定seedの独立core比較でも墓石命中と文字列で約5〜10%回帰し、両compiler・全操作での利益がない。strings mainはlocate未使用でコード節byte一致のため時間変動を本体効果と数えない。"
          }
        ]
      },
