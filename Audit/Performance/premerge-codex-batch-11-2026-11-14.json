    {
      "id": "eratosthenes",
      "source_sha256": "c22c53aac5ab7ec632a97e39e73283675b415bdb98f877972d0b97ba03db9168",
      "input_source_sha256": "c22c53aac5ab7ec632a97e39e73283675b415bdb98f877972d0b97ba03db9168",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "prime_countとfor_each_prime_strideで中間prime配列を作らず必要出力のみ列挙。大step word-popcount経路は適用済み。0/1/2と64bitnの範囲・strideオーバーフロー保護を維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-06-2026-11-13.json",
            "decision": "adopt",
            "candidate_reason": "N=5e8では素数が約2630万個あり、出力数の上限からa≥27になるため、奇数64個のワード(平均約6素数)の大半は出力対象を含まない。現mainは全素数でコールバックとbit消去を回し、ワード末尾の分岐予測ミスも毎ワード払う。残りスキップ数がワードのpopcount以上なら丸ごと飛ばせる。popcnt命令が無いビルドやaが小さい入力では逆効果の恐れがあり、閾値は測定で決める。",
            "decision_reason": "既存API/格納/所有を保つ追加stride列挙。40,260,156 small全数とMAX/word/0/1/2/callback契約、最終32構成+Example4、CI runtime4/生成28構成が通過。大Nの合法出力上限に対応するstep27/大stepで約9〜25%短縮。小stepは旧APIへ、identityは直接委譲。小aの約0.07〜0.08ms/約1%の小差と反復範囲重複を明記し、全入力一律改善とは主張しない。DocumentはAPI表/短例/前提中心へ整理し旧内部解説はAuditへ保存。"
          }
        ]
      },
