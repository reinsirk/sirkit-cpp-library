    {
      "id": "rollback_weighted_union_find_rollback",
      "source_sha256": "b2edeb19e98dd6a33b5b962a794e07358912576dcb5b01da8907b8949965b3ce",
      "input_source_sha256": "b2edeb19e98dd6a33b5b962a794e07358912576dcb5b01da8907b8949965b3ce",
      "decision": {
        "decision": "unchanged_no_new_candidate",
        "current_review_reason": "queryにrollbackを作らず、子のないuniteを省略する改善を適用済み。false uniteも1履歴としてstate保存し、実測で残ったunion-first分岐順を維持。",
        "historical_candidate_decisions": [
          {
            "record": "Audit/optimization-fable-batch-05-2026-11-13.json",
            "decision": "adopt",
            "candidate_reason": "照会ノード(type1)は状態を変えないのでexitフレームとrollbackが不要。子のないuniteノードは誰にも観測されないので実行自体が不要。random入力では葉が多く、unite・履歴push・rollbackとスタック往復を減らせる見込み（未測定）。",
            "decision_reason": "queryはconst/初期snapshot0不変、false uniteも1履歴のため非葉uniteのみstate保存/rollbackへ。原案はGCCline小回帰で退け、元のunion-first分岐順を保つ同論理版を採用。独立295入力/query親深鎖/line/star/root-only/履歴probeと最終生成CI通過、両compilerで非回帰、random/star改善。新mainもO3維持。"
          }
        ]
      },
