      "coverage": [
        "root(i) produces component-sum key",
        "size(i) supplies cross-component pair count",
        "unite(i,j) determines a successful merge",
        "version()/Version saves each successful merge handle",
        "issame(i,j) handles current reachability",
        "issame(i,j,Version) determines earliest minimax threshold"
      ],
      "limitations": [
        "Only chronological successful-merge versions here; existing LC persistent_unionfind remains needed for arbitrary branching versions.",
        "No restore, copy/move/exception or externally supplied foreign handle exercised by this problem.",
        "Maximum-constraint timing/RSS and large balanced-merge modular check are handled separately by root agent."
      ],
      "proof": [
        "Edges arrive in nondecreasing weight order: adding an edge inside one component cannot lower any existing minimax distance.",
        "A merge with weight w newly connects exactly sizeA*sizeB unordered pairs, all at minimax distance w; old internal distances stay unchanged.",
        "The first retained version connecting distinct u,v corresponds exactly to their minimax distance; self-distance is zero.",
        "A disconnected type-2 query outputs -1 without updating X.",
        "After modular reduction each multiplication is at most (998244353-1)*200000 < 2**63; component-sum addition is less than 3*998244353.",
        "Version handles are retained while their owning uf object remains alive."
      ],
      "complexity": {
        "type1": "O(log^2(N+1))",
        "type2": "O(log^3(N+1))",
        "type3": "O(log^2(N+1))",
        "type4": "O(1)",
        "space": "O(N log(N+1)) persistent nodes; at most N retained versions"
      },
      "oracle": "Independent all-pairs Floyd minimax closure after every inserted edge; all type-2 answers and component pair sums directly read/summed from matrix. No Union-Find, retained versions or threshold binary search in reference.",
      "fixture_count": 87,
      "query_count": 10331
    }
