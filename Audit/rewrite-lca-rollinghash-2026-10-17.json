      ],
      "independent_comparisons_per_configuration": 2505536,
      "cases": "uint128 polynomial % reference; all bytes0..255; base boundaries; random canonical hash concatenation; empty/moved objects; length/base/range errors; copy/move/swap; modular boundary values"
